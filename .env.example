# Copy to .dev.vars for local Worker execution. Never commit real secrets.
# Only enable while the Site is owner-private. Disable after owner setup.
BOOTSTRAP_ENABLED=false
# DB and BUCKET are provisioned bindings, not connection-string secrets.
# No online payment provider is implemented; do not add keys expecting activation.
# Provider-specific merchant ID, signing secret and endpoint names must be added
# with the chosen provider adapter and verified against its merchant documentation.

# Required exact trusted owner email for first-owner setup. Local mock only:
BOOTSTRAP_OWNER_EMAIL=seedy@sites.test
